+package com.radiology1405.prep.data
+
+/**
+ * Release-safety guard for a single official-origin item with unresolved official key
+ * reconciliation and malformed learner-visible fallback options. This is a delivery
+ * exclusion, not a bank rewrite: stable ID, raw bank row, prior attempts, mastery,
+ * backups, and snapshots remain preserved.
+ */
+object QuestionDeliveryExclusions {
+    const val GEO153 = "real_1401_in_geo_153"
+
+    private val blockedIds = setOf(GEO153)
+
+    fun blocks(id: String): Boolean = id in blockedIds
+
+    fun filter(ids: Iterable<String>): List<String> = ids.filterNot(::blocks)
+}
